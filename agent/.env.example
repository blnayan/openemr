# ============================================================================
# AgentForge — environment template
# ============================================================================
#
# Copy this file to `.env.local` (gitignored) and fill in real values:
#     cp agent/.env.example agent/.env.local
#
# The same file is consumed by:
#   • the Node sidecar (agent/src/config.ts loads it via dotenv)
#   • the OpenEMR PHP container (mounted by docker-compose.agentforge.yml so
#     interface/agentforge/*.php can read AGENTFORGE_JWT_SECRET and
#     AGENTFORGE_SERVICE_URL)
#
# Never commit a filled-in copy. The HS256 secret, the FHIR private key, and
# the OpenAI/Langfuse API keys are all enough to compromise PHI.
#
# ============================================================================


# ----------------------------------------------------------------------------
# REQUIRED — Auth bridge between OpenEMR PHP and the Node sidecar
# ----------------------------------------------------------------------------

# HS256 shared secret (>= 32 chars). PHP's ScopedJwtMinter signs a 120-second
# JWT per request; the sidecar's verifyJwt middleware validates it with the
# same secret. Generate with:
#     openssl rand -hex 32
AGENTFORGE_JWT_SECRET=

# How the OpenEMR container reaches the sidecar. Inside docker-compose this
# is the service name; for a host-only setup use http://localhost:<port>.
AGENTFORGE_SERVICE_URL=http://agentforge:3000


# ----------------------------------------------------------------------------
# REQUIRED — OpenEMR FHIR / OAuth (SMART backend-services client_credentials)
# ----------------------------------------------------------------------------
# OpenEmrTokenProvider obtains an access token by signing a client_assertion
# JWT with OPENEMR_FHIR_PRIVATE_KEY_PATH (RS384) and POSTing it to
# OPENEMR_OAUTH_BASE_URL/token. The resulting token is the bearer on every
# FHIR call.

# Where the sidecar actually hits FHIR. Inside docker, the compose override
# forces this to http://openemr/apis/default/fhir.
OPENEMR_FHIR_BASE_URL=https://localhost:9300/apis/default/fhir

# Where the sidecar POSTs the token request. Inside docker, the override
# forces http://openemr/oauth2/default.
OPENEMR_OAUTH_BASE_URL=https://localhost:9300/oauth2/default

# What the `aud` claim in the client_assertion JWT must match (OpenEMR's
# advertised public token endpoint, i.e. site_addr_oath). Often differs from
# OPENEMR_OAUTH_BASE_URL when the sidecar is on a private docker network.
OPENEMR_OAUTH_PUBLIC_BASE_URL=https://localhost:9300/oauth2/default

# DEV ONLY — bypasses TLS verification when talking to OpenEMR's self-signed
# https://localhost:9300 endpoint outside docker. MUST be 0 (or unset) in any
# deployed environment. Double-check before pushing to Railway / prod.
OPENEMR_FHIR_TLS_INSECURE=0

# Registered system client (registered by contrib/agentforge/setup_system_client.php).
# Stored in oauth_clients with client_role=system, grant_types=client_credentials,
# and the public JWK in `jwks`.
OPENEMR_FHIR_CLIENT_ID=

# Path to the RS384 private key (PEM) inside the sidecar container. The
# matching public JWK lives in oauth_clients.jwks. Generate with:
#     node agent/scripts/gen-keys.mjs
# Then re-register: docker compose exec openemr php contrib/agentforge/setup_system_client.php \
#     --jwks-file=/var/www/localhost/htdocs/openemr/agent/secrets/jwks.json
OPENEMR_FHIR_PRIVATE_KEY_PATH=/app/secrets/private.pem

# Public JWKS as a single-line JSON string. Contents of agent/secrets/jwks.json.
# When set together with OPENEMR_FHIR_CLIENT_ID, auto_configure.php registers
# the SMART system OAuth client on every fresh container boot — required
# whenever you tear down volumes (`docker compose down -v`), otherwise the
# patient dashboard Co-Pilot returns `agent_unavailable` until you run
# setup_system_client.php manually. Public key only — safe in env.
# OPENEMR_AGENTFORGE_JWKS_JSON={"keys":[{"kty":"RSA","n":"...","e":"AQAB","alg":"RS384","use":"sig","kid":"agentforge-1"}]}


# ----------------------------------------------------------------------------
# Sidecar runtime
# ----------------------------------------------------------------------------

# Port the Fastify server listens on inside the container. Railway's $PORT
# overrides this when present.
AGENT_SERVICE_PORT=3000

# Reasoning model used for follow-up turns. Pre-visit defaults to the same
# model (see AGENTFORGE_PREVISIT_MODEL below) when AGENTFORGE_PREVISIT_USE_LLM=1.
# Any OpenRouter slug works here (e.g. anthropic/claude-sonnet-4,
# openai/gpt-4o-mini, google/gemini-2.5-flash).
AGENTFORGE_MODEL=anthropic/claude-haiku-4.5

# Model used by the supervisor's Synthesizer worker to compose the final
# claims/citations payload from per-worker drafts. Splitting this from
# AGENTFORGE_MODEL lets the planner run on a fast/cheap model while
# synthesis (which has tighter quality demands on grounding + citation
# layout) runs on the same or a stronger model. Defaults to AGENTFORGE_MODEL
# when unset.
AGENTFORGE_SYNTHESIZER_MODEL=anthropic/claude-haiku-4.5

# Optional. Set to "true" to bypass the LLM entirely and use the deterministic
# stub planner — useful for offline demos and CI.
# STUB_PLANNER=true

# Optional. Fastify log level: trace | debug | info | warn | error | fatal.
# LOG_LEVEL=info


# ----------------------------------------------------------------------------
# REQUIRED for non-stub mode — OpenRouter
# ----------------------------------------------------------------------------
# OpenRouter is the only LLM provider. Single API key, any model slug
# (anthropic/claude-haiku-4.5, openai/gpt-4o-mini, google/gemini-2.5-flash, …).
# Get a key from https://openrouter.ai/keys. The sidecar uses @langchain/openai
# pointed at OPENROUTER_BASE_URL since OpenRouter is OpenAI-compatible.
OPENROUTER_API_KEY=

# Optional. Override the OpenRouter API base if you're using a proxy or a
# self-hosted gateway. Defaults to https://openrouter.ai/api/v1.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. Identify this app on the OpenRouter dashboard. Both are sent as
# request headers (HTTP-Referer / X-Title) and have no functional effect.
# OPENROUTER_REFERER=https://your-app.example.com
# OPENROUTER_APP_TITLE=AgentForge


# ----------------------------------------------------------------------------
# Optional — pre-visit LLM polish
# ----------------------------------------------------------------------------
# Pre-visit defaults to a deterministic, sub-second answer with no LLM call.
# Setting AGENTFORGE_PREVISIT_USE_LLM=1 polishes the summary at the cost of a
# 5-7 s round-trip. AGENTFORGE_PREVISIT_MODEL picks the model (any OpenRouter
# slug); defaults to anthropic/claude-haiku-4.5.
# AGENTFORGE_PREVISIT_USE_LLM=1
# AGENTFORGE_PREVISIT_MODEL=anthropic/claude-haiku-4.5


# ----------------------------------------------------------------------------
# REQUIRED for retrieval — Pinecone (hybrid retriever, issue 05)
# ----------------------------------------------------------------------------
# The retrieval pipeline uses Pinecone Inference for both embedding
# (server-side, integrated index) and reranking. Index name is
# versioned — a re-chunking strategy change requires a new index, never
# poisons the existing one. Model slugs are pinned; never `latest`.

# VLM model slug for the document-extraction pipeline. Pinned (no
# `latest`) so a vendor-side weights swap can't change extraction
# behavior under us.
#
# The extractor uses tool-calling to enforce a structured-output
# contract (Zod schema bound as a tool), so the model MUST be one
# OpenRouter advertises with tool-use endpoints AND vision support.
# We previously pinned qwen/qwen2.5-vl-72b-instruct but OpenRouter
# returns "404 No endpoints found that support tool use" for it,
# so we default to gemini-2.5-flash (vision + tool-use, low cost).
# anthropic/claude-haiku-4.5 / claude-sonnet-4.6 are also acceptable.
OPENROUTER_VLM_MODEL=google/gemini-2.5-flash

# Optional model slug for the LLM-driven bbox selector that maps each
# extracted entity to the OCR line indices that constitute its
# bounding box. Text-only input (no image), so any cheap chat model
# works. Defaults to OPENROUTER_VLM_MODEL when unset; set this
# explicitly to drop the bbox-selection cost without changing the VLM.
# OPENROUTER_BBOX_SELECTOR_MODEL=google/gemini-2.5-flash

# Pinecone — used by the hybrid retriever (issue 05). Leave the API
# key blank to skip retrieval entirely; the agent service starts
# fine without it (the supervisor's evidence-retriever worker just
# returns empty chunks).
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agentforge-guidelines-v1
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_RERANK_MODEL=bge-reranker-v2-m3
PINECONE_RERANK_FALLBACK_MODEL=bge-reranker-v2-m3

# Bootstrap ingest gates (issue 18). Set to 1 to enable the
# (idempotent) guideline ingest into Pinecone or the demo-fixture
# ingest into OpenEMR's sidecar at agent-service boot. Auto-set to
# `1` by the bootstrap module when RAILWAY_ENVIRONMENT is non-empty,
# mirroring the Synthea seeder's three-way resolver pattern in
# auto_configure.php. Operator override (gate=0) always wins.
AGENTFORGE_GUIDELINES_INGEST=
AGENTFORGE_FIXTURE_INGEST=

# Optional override for the OpenEMR origin the agent uses to reach
# interface/agentforge/sidecar.php. Derived from OPENEMR_FHIR_BASE_URL
# when unset.
# OPENEMR_SIDECAR_BASE_URL=http://openemr


# ----------------------------------------------------------------------------
# Document-extraction OCR — Google Cloud Vision
# ----------------------------------------------------------------------------
# The bbox extraction layer combines:
#   1. Google Cloud Vision (DOCUMENT_TEXT_DETECTION) for pixel-accurate
#      OCR over rendered page PNGs.
#   2. The OPENROUTER_VLM_MODEL above for structured extraction.
#   3. The OPENROUTER_BBOX_SELECTOR_MODEL above to map each row to the
#      OCR line indices that form its bbox (handles wrapped rows that
#      Tesseract-style line analysis would split incorrectly).
#
# Leave GOOGLE_VISION_API_KEY blank to disable OCR entirely; the
# pipeline still extracts text via the VLM but every bbox falls back
# to a zero-area placeholder (overlay viewer renders nothing).
#
# PHI note: lab/intake content WILL be sent to Google Cloud Vision.
# A signed Google Cloud BAA is required for production use with PHI.
# Local dev / non-PHI inputs work without one.
#
# Get a key at https://console.cloud.google.com → enable Cloud Vision
# API → APIs & Services → Credentials → Create credentials → API key.
GOOGLE_VISION_API_KEY=


# ----------------------------------------------------------------------------
# REQUIRED — PHI redaction
# ----------------------------------------------------------------------------
# Salt fed to HMAC-SHA256 when generating per-value redaction tokens
# ([REDACTED:type:hmac8]). The salt is *not* a secret in the sense of
# encryption (the algorithm is one-way), but rotating it intentionally
# breaks cross-deployment trace joining — old traces and new traces will
# carry different tokens for the same patient name. Rotate per
# deployment in production.
#
# Generate with:
#     openssl rand -hex 32
#
# There is no runtime opt-out for the redactor — the observability wrapper
# in src/observability/tracedClient.ts throws if this is unset, by
# design. Tests must set it explicitly.
AGENTFORGE_PHI_REDACTION_SALT=

# ----------------------------------------------------------------------------
# Optional — observability (Langfuse)
# ----------------------------------------------------------------------------
# When both LANGFUSE_SECRET_KEY and LANGFUSE_PUBLIC_KEY are set, every
# @traceable-wrapped operation ships redacted traces to Langfuse.
# Leave either key blank to fully disable export.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional logical grouping for your Langfuse workspace filters:
LANGFUSE_RELEASE=agentforge-copilot


# ----------------------------------------------------------------------------
# CI eval gate — required secrets
# ----------------------------------------------------------------------------
# The .github/workflows/agentforge-eval.yml workflow runs the W2 eval suite
# (10 evidence + 5 PHI-leak + 4 anti-hallucination cases) on every PR and
# every push to main / master. It requires these secrets to be set under
# Settings → Secrets → Actions:
#
#   - OPENROUTER_API_KEY              (already required above for non-stub mode)
#   - PINECONE_API_KEY                (already required for retrieval)
#   - LANGFUSE_SECRET_KEY / LANGFUSE_PUBLIC_KEY (required for noPhiInLogs trace capture)
#   - AGENTFORGE_JWT_SECRET           (required for eval JWT minting)
#   - AGENTFORGE_PHI_REDACTION_SALT   (required by the PHI redactor at startup)
#
# The eval gate cannot be bypassed by `--no-verify` — local pre-commit
# hooks are convenience only; the GitHub Action is the source of truth.
# Baseline regressions of more than 5 percentage points fail the build.
# To intentionally raise the baseline, open a PR titled
# `promote eval baseline` modifying `agent/evals/baseline.json`.


# ----------------------------------------------------------------------------
# Optional — admin demo-data refresh endpoint
# ----------------------------------------------------------------------------
# Used by interface/agentforge/admin/refresh.php to gate a destructive
# Synthea reseed. Only set in dev / demo environments.
# AGENTFORGE_ADMIN_TOKEN=
# AGENTFORGE_SYNTHEA_DIR=/var/www/localhost/htdocs/openemr/contrib/agentforge/synthea
# OE_DEMO_SEED_LIMIT=10
