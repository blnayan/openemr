# ============================================================================
# OpenEMR service — environment template
# ============================================================================
#
# Copy to `.env` (gitignored) and fill in real values for local docker runs.
# On Railway, set these as service environment variables instead.
#
# This template covers the OpenEMR PHP service. The Node sidecar has its
# own template at `agent/.env.example` — keep AGENTFORGE_JWT_SECRET in
# sync between the two services.
#
# ============================================================================


# ----------------------------------------------------------------------------
# Upstream OpenEMR
# ----------------------------------------------------------------------------

# Possible options are prod or dev. No spaces, no quotes.
OPENEMR__ENVIRONMENT=

# Set to true to disable periodic background service execution (Ajax piggybacking).
# Session timeouts and notification badges remain active. Accepts true/1 or false/0.
OPENEMR__NO_BACKGROUND_TASKS=


# ----------------------------------------------------------------------------
# Database (read by auto_configure.php on first boot)
# ----------------------------------------------------------------------------
# On Railway, attach a MySQL/MariaDB plugin to the OpenEMR service and
# Railway will inject MYSQL_HOST / MYSQL_PORT / MYSQL_DATABASE / MYSQL_USER /
# MYSQL_PASS automatically. MYSQL_ROOT_USER / MYSQL_ROOT_PASS are required
# for first-time install (creating the OpenEMR DB user) and for
# contrib/agentforge/run_migrations.php's ALTER TABLE on `lists` / `pnotes`.

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=openemr
MYSQL_USER=openemr
MYSQL_PASS=
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASS=

# Optional. Defaults to utf8mb4_general_ci.
# MYSQL_COLLATE=

# Optional. Set to "1" to skip the root-user step (managed DBs that don't
# expose root credentials).
# NO_ROOT_DB_ACCESS=


# ----------------------------------------------------------------------------
# OpenEMR install bootstrap (first-boot admin user)
# ----------------------------------------------------------------------------

OE_USER=admin
OE_PASS=pass
OE_USER_FIRSTNAME=Admin
OE_USER_LASTNAME=User
OE_GROUP=Default
OPENEMR_SITE=default
OPENEMR_HOST=


# ----------------------------------------------------------------------------
# Public URL (used by the SMART system client `aud` claim)
# ----------------------------------------------------------------------------
# auto_configure.php registers the SMART backend-services client with this
# URL as the OAuth audience the agent service must match. Either set
# OPENEMR_PUBLIC_URL explicitly OR let Railway's RAILWAY_PUBLIC_DOMAIN
# (auto-injected) be used — auto_configure.php prepends https:// to it.
# Leave both unset for local dev.

# OPENEMR_PUBLIC_URL=https://openemr.your-app.up.railway.app


# ----------------------------------------------------------------------------
# AgentForge — REQUIRED
# ----------------------------------------------------------------------------

# HS256 shared secret. Must match agent/.env's AGENTFORGE_JWT_SECRET.
# Generate with: openssl rand -hex 32
AGENTFORGE_JWT_SECRET=

# How OpenEMR PHP reaches the agent service. On Railway, this is the
# agent service's *internal* URL (e.g. http://agent.railway.internal:3000).
AGENTFORGE_SERVICE_URL=http://agentforge:3000

# Registered SMART system client_id. auto_configure.php will register the
# client on every fresh boot when this AND OPENEMR_AGENTFORGE_JWKS_JSON
# are both set; otherwise the patient dashboard Co-Pilot returns
# `agent_unavailable` until you run setup_system_client.php manually.
OPENEMR_FHIR_CLIENT_ID=

# Public JWK matching the agent's RS384 private key (single-line JSON).
# The contents of agent/secrets/jwks.json. Public key only — safe in env.
# Generate with: node agent/scripts/gen-keys.mjs
# OPENEMR_AGENTFORGE_JWKS_JSON={"keys":[{"kty":"RSA","n":"...","e":"AQAB","alg":"RS384","use":"sig","kid":"agentforge-1"}]}
OPENEMR_AGENTFORGE_JWKS_JSON=


# ----------------------------------------------------------------------------
# AgentForge — Demo data seed
# ----------------------------------------------------------------------------
# The MVP demo is the four AGENTFORGE-DEMO-PDF-001..004 patients seeded by
# contrib/agentforge/seed_demo_pdf_patients.php. Resolution order:
#   1. AGENTFORGE_DEMO_PDF_SEED set explicitly → that value wins (1 = on,
#      anything else = off).
#   2. Else if RAILWAY_ENVIRONMENT is non-empty (Railway auto-injects this)
#      → defaults to ON. Railway deploys land on the demo automatically.
#   3. Else (local docker, CI) → off.
# Idempotent — patients already at the right pubpid are left alone.
# AGENTFORGE_DEMO_PDF_SEED=1


# ----------------------------------------------------------------------------
# AgentForge — Optional admin endpoints (dev only)
# ----------------------------------------------------------------------------
# Token gating the destructive demo-data refresh endpoint at
# interface/agentforge/admin/refresh.php. Leave unset in production —
# the endpoint refuses to run without it.
# AGENTFORGE_ADMIN_TOKEN=
